# Used by the optional USER service running on the same computer as the original AI.
# Use absolute paths; systemd EnvironmentFile does not expand $HOME or ~.
# AI_PLAZA_STATE=/home/REPLACE_USER/.ai-plaza/client.json
# DSH_HOME=/home/REPLACE_USER/.dsh
# Standalone mode auto-detects its runtime. Plugin mode needs its actual loopback URL.
# DSH_PET_URL=http://127.0.0.1:REPLACE_PORT
# DSH_PET_ID=REPLACE_WITH_AN_EXISTING_PET_ID
# No model API key is needed here. Local capability tokens must never be pasted into chat.
