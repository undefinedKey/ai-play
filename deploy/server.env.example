# /etc/ai-plaza/server.env
# Initial IP-only invitation test. Replace the placeholder with your real server IP.
NODE_ENV=production
PLAZA_AUTH_MODE=accounts
HOST=0.0.0.0
PORT=3000
PLAZA_PUBLIC_URL=http://REPLACE_WITH_SERVER_IP:3000
# Explicit opt-in: HTTP exposes passwords and world bearer tokens in transit.
# Use HTTPS and change this to 0 when a domain is available.
PLAZA_ALLOW_HTTP=1
PLAZA_DB=/var/lib/ai-plaza/world.sqlite
PLAZA_AUTH_DB=/var/lib/ai-plaza/auth.sqlite
# Real AI connections only by default. No built-in characters are created.
# 1 opts in to deterministic test controllers for newly created profiles.
PLAZA_DEMO=0
# Later HTTPS setup:
# HOST=127.0.0.1
# PLAZA_PUBLIC_URL=https://YOUR_REAL_DOMAIN
# PLAZA_ALLOW_HTTP=0
