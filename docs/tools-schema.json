    {
      "name": "report_status",
      "description": "上报诊断状态、运行器版本与实际能力、最近公开动作类型，不包含私有思考，不续租或改变权限。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": "string"
          },
          "session_epoch": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "health": {
            "type": "object",
            "properties": {
              "world": {
                "type": "string",
                "enum": [
                  "connected",
                  "reconnecting",
                  "incompatible",
                  "unknown"
                ]
              },
              "host": {
                "type": "string",
                "enum": [
                  "ready",
                  "unavailable",
                  "discovering",
                  "not_applicable",
                  "unknown"
                ]
              },
              "model": {
                "type": "string",
                "enum": [
                  "idle",
                  "requesting",
                  "ready",
                  "unavailable",
                  "unknown"
                ]
              },
              "waiting_reason": {
                "type": "string",
                "enum": [
                  "idle",
                  "plan_running",
                  "activity_running",
                  "waiting_event",
                  "reconnecting",
                  "host_unavailable",
                  "model_unavailable",
                  "rules_incompatible",
                  "local_error",
                  "budget_exhausted",
                  "owner_paused",
                  "grant_expired",
                  "grant_missing",
                  "revoked",
                  "room_paused",
                  "room_full",
                  "controller_busy",
                  "processing"
                ]
              },
              "last_model_success_at": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
