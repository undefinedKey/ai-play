{
  "world_api_version": "0.2",
  "tools": [
    {
      "name": "report_connection",
      "description": "上报主人可见的连接诊断。允许当前控制端在离线或暂停时报告；不会续租、入场或改变授权与预算。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "demo",
              "model",
              "dsh-pet"
            ]
          },
          "runtime_version": {
            "type": "string",
            "pattern": "^\\d{1,4}\\.\\d{1,4}\\.\\d{1,4}$"
          },
          "capabilities": {
            "maxItems": 16,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z_]{1,32}$"
            }
          },
          "health": {
            "type": "object",
            "properties": {
              "world": {
                "type": "string",
                "enum": [
                  "connected",
                  "reconnecting",
                  "incompatible",
                  "unknown"
                ]
              },
              "host": {
                "type": "string",
                "enum": [
                  "ready",
                  "unavailable",
                  "discovering",
                  "not_applicable",
                  "unknown"
                ]
              },
              "model": {
                "type": "string",
                "enum": [
                  "idle",
                  "requesting",
                  "ready",
                  "unavailable",
                  "unknown"
                ]
              },
              "waiting_reason": {
                "type": "string",
                "enum": [
                  "idle",
                  "plan_running",
                  "activity_running",
                  "waiting_event",
                  "reconnecting",
                  "host_unavailable",
                  "model_unavailable",
                  "rules_incompatible",
                  "local_error",
                  "budget_exhausted",
                  "owner_paused",
                  "grant_expired",
                  "grant_missing",
                  "revoked",
                  "room_paused",
                  "room_full",
                  "controller_busy",
                  "processing"
                ]
              },
              "last_model_success_at": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "last_request_at": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "last_host_success_at": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "last_world_success_at": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "error_code": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "counters": {
                "type": "object",
                "properties": {
                  "requests": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "replies": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "retries": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "local_failures": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "requests",
                  "replies",
                  "retries",
                  "local_failures"
                ],
                "additionalProperties": false
              },
              "pending_events": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "dropped_events": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "token_usage": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "input_tokens": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "output_tokens": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "source": {
                        "type": "string",
                        "const": "provider"
                      }
                    },
                    "required": [
                      "input_tokens",
                      "output_tokens",
                      "source"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "world",
              "host",
              "model",
              "waiting_reason"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "health"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "get_rules",
      "description": "读取广场规则、冒险 adventure、疲劳 fatigue、生活 life：采集 gathering 和 resources 的真实共享节点目录/交互点/库存容量/预约与再生规则/工具/时段条件，day_cycle 的持久昼夜与夜间成本、料理 recipes 与 food 的 heal/energy_restore、营地补给 market 的买卖价格/每角色窗口额度；以及探索adventure.exploration、公开短期目标personal_goals、策略装备life.strategy_equipment和农田/农具/装备、休闲与游戏目录、cooperation 两种自愿合作模板/分工/成本/固定期限和 Skill 版本。survival.version:1提供饱食、建火站点/配方/光照/燃料/火把与夜暗风险；资源ecology给成熟/树桩/空地/幼苗/幼树与下一阶段。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "test_connection",
      "description": "无副作用的隔离连接测试，不占位或创建运行。",
