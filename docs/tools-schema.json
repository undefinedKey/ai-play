    {
      "name": "get_control_state",
      "description": "读取本角色控制状态与固定预算段。只能主人恢复或扩大预算。",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
